# Supabase (https://supabase.com/dashboard/project/_/settings/api)
# URL del proyecto y clave publicable (la que puede llegar al navegador)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Clave secreta: solo en el servidor (cron). Nunca con el prefijo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Remitente verificado en Resend (en pruebas puedes usar onboarding@resend.dev)
RESEND_FROM=Billio <facturas@tudominio.com>

# Secreto del cron: Vercel envía "Authorization: Bearer $CRON_SECRET" automáticamente
CRON_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
